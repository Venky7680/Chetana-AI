# Copy to .env and fill in. Never commit .env.

# Sign JWTs for console sessions. Generate one:
#   cd bff && python -m app.cli new-secret
CHETANA_JWT_SECRET=

# Deployment-wide autonomy ceiling (the strictest of this and each tenant's wins):
#   0 = read only, nothing writes
#   1 = auto-reversible writes run; anything heavier is parked for approval  (recommended start)
#   2 = workflow execution and other effort-reversible actions run unattended
#   3 = irreversible actions run unattended (do not use in production)
CHETANA_GLOBAL_MAX_AUTONOMY_TIER=1

# Either a path to a JSON file or an inline JSON array.
CHETANA_TENANTS_JSON=/config/tenants.json
CHETANA_USERS_JSON=/config/users.json

CHETANA_ENVIRONMENT=local

# --- AI investigation (HolmesGPT, Layer 5) -----------------------------------
# Bedrock credentials. These reach the MODEL only — HolmesGPT is given no
# credentials for the client estate at all; it reads through Chetana's evidence
# gateway with a per-investigation token. See ops/holmes/toolsets.yaml.
#
# A Bedrock API key is a bearer token and is all you need. Paste it here.
AWS_BEARER_TOKEN_BEDROCK=

# Required even with an API key: keys are issued per region, and the region is
# what builds the endpoint. Must match the region the key was created in.
AWS_REGION_NAME=us-east-1

# Only for deployments using an IAM role or long-lived access keys instead of
# an API key. Leave blank when AWS_BEARER_TOKEN_BEDROCK is set.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Which Bedrock model answers. Must be available in AWS_REGION_NAME.
#
# The "us." prefix is required, not cosmetic: newer Anthropic models on Bedrock
# reject their own bare model id with "on-demand throughput isn't supported" and
# demand a geo inference profile. Match the prefix to your region family —
# us. / eu. / au. / global.
#
# Model ids churn, and Bedrock retires old ones: a model marked Legacy that your
# account has not called in 30 days starts refusing with "Access denied. This
# Model is marked by provider as Legacy". When that happens it is this one line
# that changes — nothing else in Chetana cares which model answers.
CHETANA_HOLMES_MODEL=bedrock/us.anthropic.claude-sonnet-5

# Shared secret between the BFF and the Holmes container. Optional locally;
# set it for anything shared. Generate with: cd bff && python -m app.cli new-secret
CHETANA_HOLMES_API_KEY=

# Set empty to switch investigation off entirely (the console hides the panel).
# CHETANA_HOLMES_BASE_URL=

# Cost controls. The first caps how many reads one investigation may make (the
# runaway-loop stop); the second caps investigations per client per hour, which
# matters because the natural trigger for one is an alert storm.
CHETANA_EVIDENCE_BUDGET_PER_INVESTIGATION=40
CHETANA_INVESTIGATIONS_PER_TENANT_PER_HOUR=20
